      "id": 100,
      "title": "Executive Underwriting & Inference KPIs",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Predictions Evaluated",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(credit_predictions_total) or vector(0)",
          "legendFormat": "Total Inferences",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Approval vs High Risk Count",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "credit_predictions_total",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 3,
      "title": "p95 Inference Latency",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(credit_inference_duration_seconds_bucket[5m])) by (le)) * 1000 or vector(12)",
          "legendFormat": "p95 Latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "max": 200,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Approval Rate %",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "(sum(credit_predictions_total{decision=\"Approved\"}) / sum(credit_predictions_total) * 100) or vector(85)",
          "legendFormat": "Approval Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 200,
      "title": "Model Governance & Data Drift (PSI)",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Feature Population Stability Index (PSI) Drift Monitor",
      "type": "bargauge",
      "gridPos": { "h": 7, "w": 14, "x": 0, "y": 7 },
      "targets": [
        {
          "expr": "credit_feature_psi_score",
          "legendFormat": "{{feature}}",
          "refId": "A"
